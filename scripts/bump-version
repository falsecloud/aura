#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [[ $# -ne 1 || ! "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Usage: $0 <major.minor.patch>" >&2
    exit 1
fi

printf '%s\n' "$1" > "$ROOT/VERSION"
echo "Aura version set to $1"
echo "Next: git add VERSION && git commit -m \"Release v$1\" && git tag v$1 && git push origin main v$1"
